# Copia este archivo como .env.local y pon tu key de TMDB (se usará en la fase 2)
# Usa el "API Read Access Token" (v4) o la "API Key" (v3) de https://www.themoviedb.org/settings/api
VITE_TMDB_KEY=pon_tu_key_aqui

# Opcional: tu servidor Jellyfin personal (proveedor src/sources/providers/jellyfin.js)
# VITE_JELLYFIN_URL=http://192.168.1.10:8096
# VITE_JELLYFIN_KEY=tu_api_key_de_jellyfin
